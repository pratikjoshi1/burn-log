{
  "name": "burn-log",
  "version": "1.0.0",
  "private": true,
  "description": "Burn Log workout tracker, packaged as an iOS app with Capacitor",
  "scripts": {
    "build": "node scripts/build.mjs",
    "ios": "node scripts/build.mjs && npx cap sync ios && npx cap open ios",
    "serve": "node scripts/build.mjs && python3 -m http.server 8080 -d www",
    "deploy": "sh scripts/deploy.sh"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@supabase/supabase-js": "^2.117.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2"
  }
}
